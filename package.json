{
  "name": "openclaw-cursor-cli",
  "version": "0.3.0",
  "description": "OpenClaw CLI backend that runs Cursor Agent (cursor-agent) as a model runtime",
  "license": "MIT",
  "type": "module",
  "files": [
    "index.js",
    "lib/",
    "bin/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.0",
      "minGatewayVersion": "2026.10.0"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.23"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "cursor",
    "cursor-agent",
    "cli-backend"
  ]
}
