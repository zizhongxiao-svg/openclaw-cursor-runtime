{
  "name": "openclaw-cursor-runtime",
  "version": "0.4.7",
  "description": "Run Cursor agents as an OpenClaw model runtime (CLI backend plugin) with OpenClaw tools, tool caps and long-lived sessions",
  "license": "MIT",
  "author": "zizhongx <zizhong.xiao@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zizhongxiao-svg/openclaw-cursor-runtime.git"
  },
  "homepage": "https://github.com/zizhongxiao-svg/openclaw-cursor-runtime#readme",
  "bugs": {
    "url": "https://github.com/zizhongxiao-svg/openclaw-cursor-runtime/issues"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/",
    "bin/",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.0",
      "minGatewayVersion": "2026.10.0"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.0"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.23"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "cursor",
    "cursor-agent",
    "cursor-sdk",
    "cli-backend",
    "ai-agent"
  ]
}
