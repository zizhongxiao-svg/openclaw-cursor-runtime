{
  "id": "cursor-cli",
  "name": "Cursor CLI",
  "description": "Run Cursor Agent (cursor-agent) as an OpenClaw CLI model backend",
  "version": "0.3.0",
  "cliBackends": [
    "cursor-cli"
  ],
  "setup": {
    "cliBackends": [
      "cursor-cli"
    ],
    "requiresRuntime": false
  },
  "activation": {
    "onStartup": false
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "command": {
        "type": "string",
        "description": "cursor-agent binary (default: cursor-agent on PATH)"
      },
      "apiKeyFile": {
        "type": "string",
        "description": "File holding CURSOR_API_KEY; used when the env var is unset"
      },
      "force": {
        "type": "boolean",
        "description": "Pass --force so tool calls run without prompts (default true)"
      },
      "transport": {
        "type": "string",
        "enum": [
          "sdk",
          "acp",
          "print"
        ],
        "description": "sdk (default): Cursor SDK agents with OpenClaw tools; acp: persistent cursor-agent acp process; print: one cursor-agent -p per turn"
      },
      "acpModelAliases": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "description": "Extra OpenClaw model id -> Cursor ACP model id mappings"
      },
      "useHttp1": {
        "type": "boolean",
        "description": "Use HTTP/1.1 for Cursor SDK agent traffic (default true; needed behind HTTP proxies)"
      },
      "modelDefaults": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "modelCatalog": {
    "providers": {
      "cursor-cli": {
        "models": [
          {
            "id": "claude-opus-5-5-low",
            "name": "Claude Opus 5.5 Low (Cursor)",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 300000,
            "contextWindows": [
              {
                "id": "300k",
                "label": "300K",
                "contextWindow": 300000
              },
              {
                "id": "1m",
                "label": "1M",
                "contextWindow": 1000000
              }
            ],
            "contextWindowDefault": "300k",
            "maxTokens": 128000
          },
          {
            "id": "claude-opus-5-5-medium",
            "name": "Claude Opus 5.5 Medium (Cursor)",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 300000,
            "contextWindows": [
              {
                "id": "300k",
                "label": "300K",
                "contextWindow": 300000
              },
              {
                "id": "1m",
                "label": "1M",
                "contextWindow": 1000000
              }
            ],
            "contextWindowDefault": "300k",
            "maxTokens": 128000
          },
          {
            "id": "claude-opus-5-5-high",
            "name": "Claude Opus 5.5 High (Cursor)",
            "reasoning": true,
            "input": [
              "text",
