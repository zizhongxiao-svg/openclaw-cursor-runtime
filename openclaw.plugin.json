{
  "id": "cursor-cli",
  "name": "Cursor Runtime",
  "description": "Run Cursor agents as an OpenClaw model runtime",
  "version": "0.4.1",
  "cliBackends": [
    "cursor-cli"
  ],
  "setup": {
    "cliBackends": [
      "cursor-cli"
    ],
    "requiresRuntime": false
  },
  "activation": {
    "onStartup": false
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "command": {
        "type": "string",
        "description": "cursor-agent binary (default: cursor-agent on PATH)"
      },
      "apiKeyFile": {
        "type": "string",
        "description": "File holding CURSOR_API_KEY; used when the env var is unset"
      },
      "force": {
        "type": "boolean",
        "description": "Auto-approve native tool permission prompts (default true). Only the acp transport surfaces prompts; with false they are routed to OpenClaw approvals."
      },
      "transport": {
        "type": "string",
        "enum": [
          "sdk",
          "acp",
          "print"
        ],
        "description": "sdk (default): Cursor SDK agents with OpenClaw tools; acp: persistent cursor-agent acp process; print: one cursor-agent -p per turn"
      },
      "acpModelAliases": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "description": "Extra OpenClaw model id -> Cursor ACP model id mappings"
      },
      "useHttp1": {
        "type": "boolean",
        "description": "Use HTTP/1.1 for Cursor SDK agent traffic (default true; needed behind HTTP proxies)"
      },
      "modelDefaults": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string"
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "description": "Default Cursor effort for models without an effort suffix when /think is not set (default medium for claude-*)"
          }
        },
        "additionalProperties": false,
        "description": "Defaults applied to Cursor model selections"
      },
      "agentIdleMinutes": {
        "type": "number",
        "minimum": 0,
        "description": "sdk transport: close cached Cursor agents idle for this many minutes (default 360; 0 disables the sweep). They are reopened on the next turn."
      }
    }
  },
  "modelCatalog": {
    "providers": {
      "cursor-cli": {
        "models": [
          {
            "id": "claude-opus-5-5",
            "name": "Claude Opus 5.5 (Cursor)",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 300000,
            "contextWindows": [
